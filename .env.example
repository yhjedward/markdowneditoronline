# ==========================================
# MD Editor WebDAV 代理服务器配置
# ==========================================

# 本代理服务器监听的端口
PORT=3000

# ==========================================
# WebDAV 后端服务器配置
# 这是实际存储文件的服务器，代理服务器会连接到这里
# ==========================================

# WebDAV 服务器协议：http 或 https
WEBDAV_PROTOCOL=http

# WebDAV 服务器主机名或 IP 地址
WEBDAV_HOST=localhost

# WebDAV 服务器端口
WEBDAV_PORT=8092

# WebDAV 服务器上的基础路径（必须以 / 开头和结尾）
# 例如：/dav/, /markdowneditor/, /remote.php/dav/files/username/
WEBDAV_PATH=/dav/

# WebDAV 认证信息（如果服务器需要认证）
# 注意：在浏览器中使用代理模式时，这些信息会被自动使用，无需在浏览器中填写
WEBDAV_USERNAME=your_username
WEBDAV_PASSWORD=your_password

# ==========================================
# 浏览器配置说明
# ==========================================
#
# 启动代理服务器后，在浏览器中配置 WebDAV 时，使用以下地址：
#
# 方式 1 - 代理模式（推荐，无需浏览器配置认证）：
#   http://localhost:3000/webdav/
#   或 https://your-domain.com/webdav/
#
# 方式 2 - 直接连接模式（需要后端服务器支持 CORS）：
#   http://your-webdav-host:8092/dav/
#
# ==========================================

